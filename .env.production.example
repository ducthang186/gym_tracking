# Sao chép thành /opt/latis/.env trên máy chủ, điền giá trị, rồi `chmod 600 .env`. KHÔNG commit file .env thật.
NODE_ENV=production
HOST=0.0.0.0                 # trong container phải nghe mọi địa chỉ để Caddy truy cập được
PORT=3000
APP_ORIGIN=https://latis.vn
TRUST_PROXY=true             # API chỉ truy cập được qua Caddy (không có ports: ra ngoài)
REQUIRE_APPROVAL=false       # true = tài khoản mới phải được admin duyệt
DATABASE_URL=postgres://latis_app:<APP_DB_PASSWORD>@db:5432/latis
JWT_SECRET=                  # openssl rand -base64 48
STORAGE_DIR=/var/lib/latis/storage
BACKUP_DIR=/var/backups/latis

# Dùng cho docker-compose (không phải cho ứng dụng):
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=             # phải trùng mật khẩu trong DATABASE_URL
