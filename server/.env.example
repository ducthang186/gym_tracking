# Sao chép thành .env và điền giá trị. Với dev, `npm run db:start` tự tạo .env cho bạn.
NODE_ENV=development
HOST=127.0.0.1            # trong Docker đặt 0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false         # đặt true khi API nằm sau Caddy (và chỉ Caddy truy cập được API)
REQUIRE_APPROVAL=false    # true = tài khoản mới phải được coach/admin duyệt
JWT_SECRET=               # >= 32 ký tự ngẫu nhiên:  openssl rand -base64 48
DATABASE_URL=postgres://latis_app:<mật khẩu>@127.0.0.1:54329/latis

# Tuỳ chọn (đã có mặc định an toàn)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# MAX_FAILED_LOGINS=10
# LOCKOUT_MINUTES=15
# RATE_LIMIT_SCALE=1
